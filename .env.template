# Copy to .env and fill in. Startup refuses to run if any value below is invalid.
# Generate a row of 6 tokens (once for MEMBER_KEY, once for LEADER_KEY):
#   python3 -c "import secrets; print(';'.join(secrets.token_hex(16) for _ in range(6)))"
# Generate a single token (RESET_TOKEN):
#   python3 -c "import secrets; print(secrets.token_hex(16))"

# Member tokens, ";" separated. Position is the team number.
MEMBER_KEY=

# Leader tokens. Same order and same count as MEMBER_KEY, and all 12 distinct.
LEADER_KEY=

# Token for POST /reset. Leave empty to disable the endpoint.
RESET_TOKEN=

# Shuffle the choice order when a question opens.
RANDOM_CHOICES=true

# Show every team's score in the top bar.
SHOW_SCORES_IN_MENU=true

# Listen address. nginx reverse-proxies to this.
HOST=127.0.0.1
PORT=20001

# Base URL make_qr.py bakes into the login QR codes.
# The camera only works over HTTPS or on localhost.
SITE_URL=https://treasure.ntust.org
